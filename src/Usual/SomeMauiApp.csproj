<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>

		<WindowsPackageType>MSIX</WindowsPackageType>

		<RootNamespace>SomeMauiApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<UseNuget>true</UseNuget>

		<!-- Display name -->
		<ApplicationTitle>SomeMauiApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.maui.somemauiapp</ApplicationId>
		<ApplicationIdGuid>dc719376-75fe-425b-b78f-0a6e0983132d</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<Version>1</Version>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
  
  <ItemGroup>
    <None Remove="Resources\Raw\shield.json" />
  </ItemGroup>
  
  <!--DrawnUI source for development: the .NET 11 checkout (DrawnUi-net11) when it sits next to this repo,
      else DrawnUi; override with -p:DrawnUiDir=...-->
  <PropertyGroup>
    <DrawnUiDir Condition="'$(DrawnUiDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\..\DrawnUi-net11')">$(MSBuildThisFileDirectory)..\..\..\DrawnUi-net11</DrawnUiDir>
    <DrawnUiDir Condition="'$(DrawnUiDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\DrawnUi</DrawnUiDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuget)' == 'true'">
    <PackageReference Include="DrawnUi.Maui" Version="1.11.0.1" />
  </ItemGroup>

  <Import Project="$(DrawnUiDir)\src\Maui\DrawnUi\DrawnUi.Maui.Source.targets" Condition="'$(UseNuget)' != 'true' And Exists('$(DrawnUiDir)\src\Maui\DrawnUi\DrawnUi.Maui.Source.targets')" />

  <ItemGroup Condition="'$(UseNuget)' != 'true'">
    <ProjectReference Include="$(DrawnUiDir)\src\Maui\DrawnUi\DrawnUi.Maui.csproj" />
  </ItemGroup>

  <ItemGroup>    
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Update="Resources\Raw\shield.json">
      <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </MauiAsset>
  </ItemGroup> 
 
</Project>
